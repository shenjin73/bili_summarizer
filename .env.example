# 复制为 .env 后按需修改。包导入时自动加载（已存在的 shell 环境变量优先）。

# --- 本地 LLM（默认优先：LM Studio + qwen3.8-27b，一个模型同时支持总结与画面 OCR）---
# LM Studio 中加载 qwen3.8-27b（MLX）并开启本地服务器（默认端口 1234）
# LOCAL_API_KEY 为占位值，本地服务器不校验
LOCAL_API_KEY=lm-studio-local
LOCAL_MODEL=qwen3.8-27b-mlx
LOCAL_BASE_URL=http://127.0.0.1:1234/v1

# --- 云端备用（本地不在线 / 模型未加载时自动切换）---
DEEPSEEK_API_KEY=sk-xxxx

# --- 其他云端（可选；本地不可用时只有 DeepSeek 会自动接管）---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# MINIMAX_API_KEY=xxxx
# OPENAI_API_KEY=sk-xxxx

# --- 多个本地端点（可选，高级）：逗号分隔的链，按顺序尝试，全部不在线才切 DeepSeek
# 设置后优先于上面的单数形式；LOCAL_MODELS / LOCAL_API_KEYS 按位置一一对应
# （单个值会应用到所有端点，缺省的 key 用占位符）
# LOCAL_BASE_URLS=http://127.0.0.1:8000/v1,http://127.0.0.1:1234/v1
# LOCAL_MODELS=model-a,model-b
# LOCAL_API_KEYS=key-a,lm-studio-local

# --- 画面分析（可选，均有默认值）---
# FRAME_INTERVAL=10            # 截图间隔秒数
# FRAME_DEDUP_THRESHOLD=10     # dHash 去重阈值（0-64，调大更激进）
# FRAME_QN=64                  # 视频流清晰度：16/32/64/80 = 360p/480p/720p/1080p
# FRAME_MAX_OCR=80             # 唯一截图上限（超出均匀采样）
# OCR_CONCURRENCY=2            # OCR 并发线程数（不设置：本地默认 2、云端默认 6）

# --- 总结输入限长（可选，字符数；超长保留头尾、丢弃中间）---
# SUMMARY_MAX_SUBTITLE_CHARS=50000
# SUMMARY_MAX_OCR_CHARS=15000
# SUMMARY_MAX_DESC_CHARS=4000
# SUMMARY_MAX_COMMENT_CHARS=3000

# --- Whisper 转写（可选）---
# WHISPER_MODEL=large-v3-turbo # mlx-community/whisper-<值>；转写即时落盘 subtitles.txt，重跑自动复用

# --- OCR 单独指定视觉模型（可选；不设置则复用上面的 LOCAL_*）---
# VISION_API_KEY=xxxx
# VISION_MODEL=qwen3.8-27b-mlx
# VISION_BASE_URL=http://127.0.0.1:1234/v1
